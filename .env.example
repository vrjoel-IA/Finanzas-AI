# Configuración de Supabase (públicas: viajan al navegador por diseño)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Configuración de Google Gemini
# SIN prefijo VITE_ a propósito: así Vite NO la incrusta en el bundle.
# Solo la lee el proxy del servidor (netlify/functions/gemini-core.mts).
GEMINI_API_KEY=
